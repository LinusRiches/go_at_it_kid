    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch index.html",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "file": "${workspaceFolder}/index.html", 
            "firefoxExecutable": "C:/Users/19137473/AppData/Local/Mozilla Firefox/firefox.exe"
        },
        {
            "name": "Launch localhost",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "url": "http://localhost/index.html",
            "webRoot": "${workspaceFolder}",
            "firefoxExecutable": "C:/Users/19137473/AppData/Local/Mozilla Firefox/firefox.exe"
        },
        {
            "name": "Attach",
            "type": "firefox",
            "request": "attach",
            "firefoxExecutable": "C:/Users/19137473/AppData/Local/Mozilla Firefox/firefox.exe"
        },
        {
            "name": "Launch WebExtension",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "addonPath": "${workspaceFolder}",
            "firefoxExecutable": "C:/Users/19137473/AppData/Local/Mozilla Firefox/firefox.exe"
        }
    ]
}